# 临时脚本与中间产物（历史上 scripts/ 曾被一次性 sha/extract 脚本污染）
# 约定：以下划线开头的脚本/文本为临时文件，不入库
scripts/_*.py
scripts/_*.txt
scripts/*_output*.txt
scripts/sha_*.txt
scripts/*.tmp

# 常见临时/系统文件
*.pyc
__pycache__/
.DS_Store
Thumbs.db

# 根目录临时草稿（历史上出现过 temp_*.md / *_test.txt 污染）
/temp_*.md
/*_test.txt
/test.txt
/enc_test.txt

# 根目录 lint 调试临时文件
/lint_*.txt

# .claude 工作区（Claude Code 的 worktree 沙箱，机器特定）
/.claude/worktrees/

# .obsidian 工作区状态（个人 UI 布局，非共享配置）
.obsidian/workspace.json

# WorkBuddy AI 记忆（知微的个人记忆，机器特定，不入共享仓库）
/.workbuddy/
